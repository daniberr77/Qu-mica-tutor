# ==============================================================================
# CONFIGURACIÓN DE LA API DE GEMINI (Google AI Studio)
# ==============================================================================
# Obtené tu API key gratuita en: https://aistudio.google.com/apikey
#
# NOTA DE SEGURIDAD:
# En aplicaciones frontend Vite, las variables con prefijo VITE_ se exponen en el
# código compilado del navegador.
# NUNCA subas archivos .env con claves reales a repositorios públicos de GitHub.
# Para desarrollo local, copiá este archivo como `.env` y agregá tu clave privada.
# ==============================================================================

VITE_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini para el tutor (Recomendado: models/gemini-3.8-flash)
VITE_GEMINI_MODEL=models/gemini-3.8-flash
