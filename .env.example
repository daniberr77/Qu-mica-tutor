# ==============================================================================
# CONFIGURACIÓN DE LA API DE GEMINI (Google AI Studio)
# ==============================================================================
# Obtené tu API key gratuita en: https://aistudio.google.com/apikey
#
# NOTA DE SEGURIDAD:
# En aplicaciones frontend Vite, las variables con prefijo VITE_ se exponen en el
# código compilado del navegador.
# NUNCA subas archivos .env con claves reales a repositorios públicos de GitHub.
# Para desarrollo local, copiá este archivo como `.env` y agregá tus claves.
# ==============================================================================

VITE_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini para el tutor (Recomendado: gemini-2.5-flash o models/gemini-3.8-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# CONFIGURACIÓN DE FIREBASE (Authentication & Firestore)
# ==============================================================================
# Pasos para obtener tus credenciales:
# 1. Ingresá a la consola de Firebase: https://console.firebase.google.com/
# 2. Creá un proyecto (ej. "quimica-tutor") o seleccioná uno existente.
# 3. En la sección "Authentication" > pestaña "Sign-in method":
#    - Habilitar proveedor: "Correo electrónico/contraseña" (Email/Password)
#    - Habilitar proveedor: "Google" (Configurá el correo de asistencia del proyecto)
# 4. En Configuración del Proyecto > pestaña General > "Tus apps", hacé clic en el ícono Web (</>)
#    y copiá los valores del objeto `firebaseConfig` a continuación:
# ==============================================================================

VITE_FIREBASE_API_KEY=tu_api_key_de_firebase_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# NOTA DE RESILIENCIA:
# Si las variables de Firebase están vacías o no configuradas, la plataforma
# cuenta con un "Modo Demo / Estudiante Invitado" integrado para que puedas probar
# y validar todas las rutas protegidas y características interactivas localmente.

# ==============================================================================
# CONFIGURACIÓN DE STRIPE (Stripe Checkout & Webhooks)
# ==============================================================================
# Clave pública de Stripe para inicializar Stripe Elements / Checkout
VITE_STRIPE_PUBLIC_KEY=pk_test_51QuimicaTutorStripeMockKeyLiveMode000

# Secreto para verificar la firma de eventos entrantes de Webhooks de Stripe
VITE_STRIPE_WEBHOOK_SECRET=whsec_quimicatutor_supersecret_stripe_webhook_key

